<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <world name="alishan_showcase">
    <gravity>0 0 -9.81</gravity>
    <physics name="showcase" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <scene>
      <ambient>0.64 0.67 0.68 1</ambient>
      <background>0.72 0.82 0.88 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="morning_sun" type="directional">
      <pose>0 0 1000 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.95 0.88 0.73 1</diffuse>
      <specular>0.10 0.10 0.08 1</specular>
      <direction>-0.45 0.35 -0.85</direction>
    </light>
    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>Alishan Showcase 1km | V1</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.64 0.67 0.68</ambient_light>
        <background_color>0.72 0.82 0.88</background_color>
        <camera_pose>-570 -680 710 0 0.52 0.86</camera_pose>
        <camera_clip>
          <near>0.5</near>
          <far>6000</far>
        </camera_clip>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="View control">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
        </gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera tracking">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
        </gz-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="WorldStats" name="Statistics">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="Screenshot" name="Screenshot">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
    </gui>
    <include>
      <uri>model://showcase_terrain</uri>
    </include>
    <include>
      <uri>model://showcase_roads</uri>
    </include>
    <include>
      <uri>model://showcase_clearings</uri>
    </include>
    <include>
      <uri>model://showcase_village</uri>
    </include>
    <include>
      <uri>model://showcase_tea</uri>
    </include>
    <include>
      <uri>model://showcase_forest</uri>
    </include>
  </world>
</sdf>