<?xml version="1.0"?>
<!--
  V1 visual-only OSM road ribbons. Each category has a separate OBJ visual so
  its explicit, matte SDF material does not depend on OBJ/MTL import behavior.
  Vertices use V0's local 500 m terrain frame and retain the +0.100 m offset.
-->
<sdf version="1.10">
  <model name="alishan_shizhuo_roads">
    <static>true</static>
    <link name="roads_visual_link">
      <visual name="secondary">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://alishan_shizhuo_roads/meshes/alishan_shizhuo_roads_secondary.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0 0 0 1</specular>
        </material>
      </visual>
      <visual name="unclassified">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://alishan_shizhuo_roads/meshes/alishan_shizhuo_roads_unclassified.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.28 0.28 0.28 1</ambient>
          <diffuse>0.28 0.28 0.28 1</diffuse>
          <specular>0 0 0 1</specular>
        </material>
      </visual>
      <visual name="service">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://alishan_shizhuo_roads/meshes/alishan_shizhuo_roads_service.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.58 0.58 0.58 1</ambient>
          <diffuse>0.58 0.58 0.58 1</diffuse>
          <specular>0 0 0 1</specular>
        </material>
      </visual>
      <visual name="track">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://alishan_shizhuo_roads/meshes/alishan_shizhuo_roads_track.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.34 0.18 0.06 1</ambient>
          <diffuse>0.34 0.18 0.06 1</diffuse>
          <specular>0 0 0 1</specular>
        </material>
      </visual>
      <visual name="path">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://alishan_shizhuo_roads/meshes/alishan_shizhuo_roads_path.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.62 0.42 0.20 1</ambient>
          <diffuse>0.62 0.42 0.20 1</diffuse>
          <specular>0 0 0 1</specular>
        </material>
      </visual>
      <visual name="footway">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://alishan_shizhuo_roads/meshes/alishan_shizhuo_roads_footway.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.72 0.54 0.30 1</ambient>
          <diffuse>0.72 0.54 0.30 1</diffuse>
          <specular>0 0 0 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
